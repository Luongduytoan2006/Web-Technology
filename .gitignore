# ==========================================
# 1. Môi trường & Thư viện (Node, Python)
# ==========================================
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Môi trường ảo Python
.venv/
venv/
env/
__pycache__/
*.pyc

# File chứa biến môi trường / bảo mật mật khẩu
.env
.env.*
!.env.example

# ==========================================
# 2. Java / JSP / Servlet (Build & Class files)
# ==========================================
# File biên dịch bytecode Java (rất nặng và sinh tự động)
*.class

# Thư mục build của Maven / Gradle / Eclipse
target/
build/
bin/
.gradle/

# File đóng gói (thường rất nặng, không nên push)
*.war
*.ear
# *.jar (chỉ mở nếu không dùng thư viện jar trong source)

# Thư mục cấu hình Workspace của Eclipse / Tomcat / NetBeans
.metadata/
.settings/
.project
.classpath
Servers/

# ==========================================
# 3. Cấu hình IDE & Trình soạn thảo
# ==========================================
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ==========================================
# 4. Hệ điều hành & File tạm
# ==========================================
Thumbs.db
Desktop.ini
.DS_Store
*.log
*.tmp
*.bak
*.swp
